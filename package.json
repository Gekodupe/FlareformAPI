{
  "name": "@flareform/api",
  "version": "0.5.0",
  "description": "Flareform API - Cloudflare Worker for forms, logs, images, and API keys",
  "homepage": "https://github.com/Gekodupe/FlareformAPI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gekodupe/FlareformAPI.git"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "db:schema:local": "wrangler d1 execute flareboard --local --file=src/schema.sql",
    "db:schema:remote": "wrangler d1 execute flareboard --remote --file=src/schema.sql",
    "db:migrate": "node scripts/d1-migrate.js",
    "db:migrate:remote": "node scripts/d1-migrate.js --remote",
    "db:local": "npm run db:schema:local",
    "db:remote": "npm run db:schema:remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "^5.8.3",
    "wrangler": "4.119.0"
  }
}
